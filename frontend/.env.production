# =====================================================================
# Production-env для фронта. Этот файл подхватывается Vite автоматически
# во время `npm run build` (или `vite build`).
#
# Логика:
#   • API → относительный путь /api → nginx того же домена → api-gateway
#   • WebSocket → пустой VITE_API_WS_URL → фронт берёт window.location.host
#     и собирает ws://realsync.ddns.net/api/interviews/sessions/<id>/ws
# Это значит, что один и тот же билд работает и на localhost, и на проде
# — domain зашит в URL посещения, а не в собранный bundle.
# =====================================================================

VITE_API_BASE_URL=/api
VITE_API_WS_URL=

VITE_APP_NAME=RealSync
VITE_APP_VERSION=1.0.0
VITE_ENABLE_ANALYTICS=false
