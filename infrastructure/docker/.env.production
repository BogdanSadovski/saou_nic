# =====================================================================
# Production-конфиг для AWS (домен http://realsync.ddns.net, HTTP-only).
#
# ⚠️  ВНИМАНИЕ: файл содержит реальные секреты — НЕ КОММИТЬ в git.
#     Проверь .gitignore: infrastructure/docker/.env* должны быть скрыты.
#
# Использование на сервере:
#     cd ~/real_ass/infrastructure/docker
#     cp .env.production .env
#     ./deploy.sh
# =====================================================================

# ── Публичный URL ────────────────────────────────────────────────────
# PUBLIC_BASE_URL — полный публичный URL приложения (используется в
# OAuth-редиректах, ссылках в письмах, deep-link для бота).
# PUBLIC_HOST — только хостнейм (legacy-фолбэк в user-service config).
# FRONTEND_BASE_URL — куда редиректит бэк после успешного OAuth.
PUBLIC_BASE_URL=http://realsync.ddns.net
PUBLIC_HOST=realsync.ddns.net
FRONTEND_BASE_URL=http://realsync.ddns.net
HTTP_PORT=80

# ── Среда ────────────────────────────────────────────────────────────
NODE_ENV=production
APP_ENV=production
LOG_LEVEL=info

# ── PostgreSQL ───────────────────────────────────────────────────────
# ⚠️ ВАЖНО: пароль ДОЛЖЕН совпадать с тем, что прошит в config.yaml
# каждого Go-сервиса (services/*/config.yaml → database.password).
# Иначе сервисы (admin, github, notification, report, resume, scoring)
# не смогут подключиться к Postgres и уйдут в Restarting. Универсальное
# значение — postgres_secret.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret
POSTGRES_DB=platform_db

# ── Redis (тот же сильный пароль, что и в локальной dev-среде) ───────
REDIS_PASSWORD=redis3t2hkGIT94GGJGLugbuiuc8

# ── JWT (минимум 32 символа, тот же что локально) ────────────────────
JWT_SECRET=super_secret_jwt_key_change_jkvrouslhv8svbaoueftg9p8oishrcb97sruovg9pvuosg97spohv
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ── OAuth GitHub (твоё текущее OAuth-приложение) ─────────────────────
# ⚠️ После запуска зайди в https://github.com/settings/developers,
#    открой приложение Ov23li3jJpAiEif2d4WW и убедись, что в
#    Authorization callback URL стоит:
#      http://realsync.ddns.net/api/auth/oauth/github/callback
#    (или добавь его рядом с локальным http://localhost:3000/...).
OAUTH_GITHUB_CLIENT_ID=Ov23li3jJpAiEif2d4WW
OAUTH_GITHUB_CLIENT_SECRET=a61e32314302c82611bd7948be2cca5a3fa35d3f
OAUTH_GITHUB_REDIRECT_URL=http://realsync.ddns.net/api/auth/oauth/github/callback

# ── GitHub-аналитика (PAT с public_repo scope) ───────────────────────
# Если в локальной .env ещё стоят плейсхолдеры — подставь свой токен
# из https://github.com/settings/personal-access-tokens/new
GITHUB_CLIENT_ID=your-github-app-client-id
GITHUB_CLIENT_SECRET=your-github-app-client-secret
GITHUB_TOKEN=ghp_your-github-personal-access-token

# ── LLM (DeepSeek) ───────────────────────────────────────────────────
# Возьми свой ключ из https://platform.deepseek.com/api_keys
# и подставь сюда ПЕРЕД первым деплоем.
LLM_API_KEY=__YOUR_DEEPSEEK_KEY__
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
# 8192 нужно, чтобы DeepSeek-V4-flash не обрезал JSON ответы для
# крупных операций (resume insights, post-analysis отчёта интервью).
# Дефолт 2048 слишком мал и приводил к "Failed to parse LLM JSON".
LLM_MAX_TOKENS=8192

# ── HH.ru API (поиск вакансий) ───────────────────────────────────────
HH_CLIENT_ID=LVCATC2PQMQRTTKE9O7V5VUB7P3CN8FQ1NQ8G362N7EOEGG0JC4UQH5C2NVLDU8O
HH_CLIENT_SECRET=NMB1HAIO45RDM2JN543FUPQ118B0184D672VSRSJFVV7EQOQ78P9UPU0BJLQS38Q
HH_API_USER_AGENT=RealSync/1.0 (bogdan.minsk@icloud.com)

# ── RabbitMQ ─────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=rabbitmq_user
RABBITMQ_DEFAULT_PASS=rabbitmqhoulgYIHKBd75tg7F78f
RABBITMQ_DEFAULT_VHOST=/

# ── ClickHouse (analytics-service) ───────────────────────────────────
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=clickhouse_user
CLICKHOUSE_PASSWORD=kRdTSlZC8mNhRwzNEYpPhTO3vpc7

# ── MinIO / S3 (загрузка резюме) ─────────────────────────────────────
